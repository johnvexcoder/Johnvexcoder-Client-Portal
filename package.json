{
  "name": "johnvexcoder-client-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:backup:local": "tsx scripts/backup.ts",
    "auth:bootstrap": "tsx scripts/bootstrap.ts",
    "auth:benchmark": "tsx scripts/benchmark.ts",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "format": "prettier --write src scripts tests *.ts *.js *.json *.jsonc README.md docs/release-status.json",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json *.jsonc README.md docs/release-status.json",
    "db:restore:check": "tsx scripts/restore-check.ts",
    "maintenance:local": "tsx scripts/maintenance-local.ts",
    "deployment:prepare": "tsx scripts/prepare-deployment.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-qr-code": "2.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261023.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  }
}
